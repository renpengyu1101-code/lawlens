# 复制为 .env 并按需填写；本文件不提交任何真实密钥
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

DILIGENCE_SECRET=please-change-this-in-production
DILIGENCE_ADMIN_EMAIL=admin
DILIGENCE_ADMIN_PASSWORD=123456

DILIGENCE_CREDITS_PER_RUN=10
DILIGENCE_REGISTER_BONUS=100

# 公网发布：HTTPS 下必须为 1；关闭自助注册改为管理员建号
DILIGENCE_COOKIE_SECURE=0
DILIGENCE_ALLOW_REGISTER=1
